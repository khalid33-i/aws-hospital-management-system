# Copy to .env and fill in. NEVER commit the real .env file.

NODE_ENV=development
PORT=3000

# --- Database (MySQL 8) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=hms_app
DB_PASSWORD=change_me_db_password
DB_NAME=hms
DB_CONNECTION_LIMIT=10
# Used only by docker-compose to initialise the MySQL container
DB_ROOT_PASSWORD=change_me_root_password
# Set DB_SSL=true when connecting to RDS; DB_SSL_CA = path to the RDS CA bundle (PEM)
DB_SSL=false
DB_SSL_CA=

# --- Auth ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars
JWT_EXPIRES_MINUTES=60
BCRYPT_ROUNDS=12
# true only when the site is served over HTTPS (cookie gets the Secure flag + HSTS)
COOKIE_SECURE=false
# Number of reverse proxies in front of the app (1 when behind an ALB)
TRUST_PROXY=0

# --- App ---
# Hospital local time zone offset used by MySQL NOW()/CURDATE()
HOSPITAL_TZ=+03:00

# Password for the demo accounts created by `npm run seed` (leave empty to generate one)
SEED_PASSWORD=
